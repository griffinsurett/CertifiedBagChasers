---
import { byItemKeys } from "@/utils/query/snippets";
import ProductFeaturedVideo from "@/components/ProductFeaturedVideo.astro";

interface Props {
  parentId: string;
  currentId: string;
  className?: string;
}

const { parentId, currentId, className = "" } = Astro.props as Props;

const [currentEntry] = await byItemKeys("products", currentId).all();
const [parentEntry] = await byItemKeys("products", parentId).all();

const currentVideo = currentEntry?.data?.featuredVideo;
const parentVideo = parentEntry?.data?.featuredVideo;
const resolvedVideo = currentVideo ?? parentVideo;
const currentImage = currentEntry?.data?.featuredImage ?? currentEntry?.data?.bannerImage;
const parentImage = parentEntry?.data?.featuredImage ?? parentEntry?.data?.bannerImage;
const resolvedImage = currentImage ?? parentImage;

if (!resolvedVideo?.src && !resolvedImage) return null;
---

<ProductFeaturedVideo
  src={resolvedVideo?.src}
  title={resolvedVideo?.title ?? "Featured Product"}
  fallbackImage={resolvedImage}
  fallbackAlt={currentEntry?.data?.title ?? parentEntry?.data?.title ?? "Featured Product"}
  className={className}
/>
