---
// src/components/ContentRenderer/variants/SocialProofVariant.astro
/**
 * SocialProofVariant - Social media screenshot carousel with section heading
 *
 * Displays social media post screenshots (Discord wins, etc.) in a carousel format.
 * Uses SectionHeading for consistent styling with other CBC sections.
 */

import type { BaseVariantProps } from "../ContentRenderer.types";
import SectionHeading from "@/components/SectionHeading.astro";
import SocialProofCarousel from "@/components/LoopTemplates/SocialProofCarousel";
import BackgroundMedia from "@/components/BackgroundMedia.astro";
import BackgroundImg from "@/assets/bent-speaking.jpg";
import { getImage } from "astro:assets";
import { getImageAlt, getImageUrl, resolveImageMetadata } from "@/utils/images";

interface Props extends BaseVariantProps {
  eyebrow?: string;
  styleVariant?: "primary" | "parts";
}

const {
  items = [],
  title,
  heading,
  description,
  className = "",
  id,
  eyebrow = "Social Proof",
  styleVariant = "primary",
} = Astro.props as Props;

// Process heading content
let displayTitle = title;
let highlightedTitle = "";

if (heading && typeof heading === 'object' && 'before' in heading) {
  displayTitle = heading.before || "";
  highlightedTitle = heading.text || "";
} else if (typeof heading === 'string') {
  displayTitle = heading;
}

interface ResponsiveImageSource {
  src: string;
  srcSet?: string;
  sizes?: string;
  width?: number;
  height?: number;
}

const SOCIAL_PROOF_SIZES =
  "(max-width: 640px) calc(100vw - 4rem), (max-width: 1024px) calc((100vw - 8rem) / 2), 340px";
const SOCIAL_PROOF_WIDTHS = [120, 180, 260, 340, 460];

const buildResponsiveImage = async (
  img: any,
): Promise<ResponsiveImageSource | undefined> => {
  if (!img) return undefined;

  if (typeof img === "string") {
    return { src: img, sizes: SOCIAL_PROOF_SIZES };
  }

  const metadata = resolveImageMetadata(img);
  if (!metadata) {
    const fallbackUrl = getImageUrl(img, "");
    return fallbackUrl ? { src: fallbackUrl, sizes: SOCIAL_PROOF_SIZES } : undefined;
  }

  const responsiveWidths = SOCIAL_PROOF_WIDTHS.filter(
    (width) => width <= metadata.width,
  );

  if (responsiveWidths.length === 0) {
    responsiveWidths.push(metadata.width);
  }

  const variants = await Promise.all(
    responsiveWidths.map((width) =>
      getImage({
        src: metadata,
        width,
        format: "webp",
        quality: 72,
      }),
    ),
  );

  const largestVariant = variants[variants.length - 1];

  return {
    src: largestVariant.src,
    srcSet: variants
      .map((variant) => `${variant.src} ${variant.attributes.width}w`)
      .join(", "),
    sizes: SOCIAL_PROOF_SIZES,
    width: largestVariant.attributes.width,
    height: largestVariant.attributes.height,
  };
};

// Transform items for the carousel component
const carouselItems = (
  await Promise.all(
    items.map(async (item) => {
      const baseImage = item.socialMediaPost || item.featuredImage;
      const responsiveImage = await buildResponsiveImage(baseImage);
      if (!responsiveImage) return null;

      return {
        id: item.slug,
        data: {
          title: item.title || "",
          socialMediaPost: responsiveImage,
          socialMediaPostAlt: getImageAlt(
            baseImage,
            `${item.title || "Certified Bag Chasers"} testimonial`,
          ),
        },
      };
    }),
  )
).filter(Boolean);
---

<section id={id} class={`section-base relative overflow-hidden ${className}`}>
  <BackgroundMedia
    backgroundMedia={{
      image: { src: BackgroundImg, fixed: true, imageClass: "bg-top" },
      overlayClass: "bg-black/70",
    }}
  />
  <div class="max-w-[1200px] mx-auto relative z-10">
    <SectionHeading
      eyebrow={eyebrow}
      title={displayTitle}
      highlightedTitle={highlightedTitle}
      description={description}
    />

    {carouselItems.length > 0 && (
      <SocialProofCarousel
        items={carouselItems}
        styleVariant={styleVariant}
        client:visible
      />
    )}
  </div>
</section>
