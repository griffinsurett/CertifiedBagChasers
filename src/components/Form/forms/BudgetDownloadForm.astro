---
import Button from "@/components/Button/Button";
import FormWrapper from "@/components/Form/FormWrapper";
import Input from "@/components/Form/inputs/Input";
import Checkbox from "@/components/Form/inputs/Checkbox";

interface Props {
  downloadUrl?: string;
  id?: string;
  className?: string;
  storageKey?: string;
  submitText?: string;
  downloadText?: string;
  title?: string;
  description?: string;
}

const {
  downloadUrl,
  id,
  className = "",
  storageKey = "budgeting-tool-download-gate",
  submitText = "Unlock Free Tool",
  downloadText = "Download Free Tool",
  title = "Get Instant Access",
  description = "Enter your email and agree to marketing to unlock your free download.",
} = Astro.props as Props;

const budgetFormId =
  import.meta.env.PUBLIC_FORMSPREE_BUDGET_TOOL_ID ||
  import.meta.env.PUBLIC_FORMSPREE_ID;

const hasDownload = Boolean(downloadUrl);
const isExternal = typeof downloadUrl === "string" && downloadUrl.startsWith("http");
---

<div
  id={id}
  class={`space-y-4 my-4 ${className}`}
  data-budget-download-gate
  data-gate-key={storageKey}
>
  {hasDownload ? (
    <div class="rounded-2xl cbc-border bg-bg/70 p-4 md:p-5">
      <div data-budget-form-wrapper>
        <FormWrapper
          client:idle
          formspreeId={budgetFormId}
          useNativeFormSubmission={true}
          reloadOnSuccess={false}
          successMessage="Thanks. Your download is now unlocked."
          errorMessage="We could not submit your form. Please try again."
          className="w-full"
        >
          <input type="hidden" name="formName" value="Certified Bag Chasers Budget Tool Download" />
          <input type="hidden" name="source" value="budgeting-tool-download" />
          <input type="hidden" name="_next" value="" data-budget-next-url />
          <input
            type="hidden"
            name="marketingConsentText"
            value="I agree to receive updates and marketing communications and acknowledge the privacy policy."
          />
          {title && <p class="text-base font-semibold text-white mb-2">{title}</p>}
          {description && <p class="text-sm text-text-secondary mb-4">{description}</p>}

          <div class="flex flex-col md:flex-row gap-1 mb-4 md:items-stretch">
            <Input
              name="email"
              type="email"
              required={true}
              placeholder="you@email.com"
              aria-label="Email address"
              showLabel={false}
              containerClassName="mb-0 flex-1"
              inputClassName="h-full w-full px-4 py-3 bg-bg cbc-border rounded-lg focus:outline-none focus:border-white/30 text-white placeholder:text-text-dim"
            />

            <Button
              type="submit"
              variant="primary"
              className="w-full md:w-auto md:min-w-[190px] md:px-6"
            >
              {submitText}
            </Button>
          </div>

          <Checkbox
            name="marketingConsent"
            required
            containerClassName="mb-0"
            labelClassName="flex items-start gap-2"
            checkboxClassName="mt-0.5 w-4 h-4 rounded border-white/20 bg-bg text-primary focus:border-white/30"
          >
            <span class="text-sm text-text-secondary">
              I agree to receive updates and marketing communications and consent to email marketing.
              See our{" "}
              <Button href="/privacy-policy" variant="link">
                Privacy Policy
              </Button>
              .
            </span>
          </Checkbox>
        </FormWrapper>
      </div>

      <div data-budget-download-action class="hidden">
        <Button
          href={downloadUrl!}
          variant="primary"
          size="lg"
          className="w-full"
          target={isExternal ? "_blank" : undefined}
          rel={isExternal ? "noopener noreferrer" : undefined}
        >
          {downloadText}
        </Button>
      </div>
    </div>
  ) : (
    <div class="rounded-2xl cbc-border bg-bg/70 p-4 md:p-5">
      <p class="text-sm text-text-muted">Set a `link` in frontmatter to enable download access.</p>
    </div>
  )}
</div>

<script is:inline>
  (() => {
    const successParam = "budget_download_unlocked";
    const roots = Array.from(document.querySelectorAll("[data-budget-download-gate]"));

    roots.forEach((root) => {
      if (!(root instanceof HTMLElement)) return;
      if (root.getAttribute("data-gate-ready") === "true") return;

      const key = root.getAttribute("data-gate-key") || "budgeting-tool-download-gate";
      const formWrapper = root.querySelector("[data-budget-form-wrapper]");
      const downloadAction = root.querySelector("[data-budget-download-action]");
      const formEl = root.querySelector("form");
      const nextInput = root.querySelector("[data-budget-next-url]");

      if (!(formWrapper instanceof HTMLElement) || !(downloadAction instanceof HTMLElement)) {
        return;
      }

      const setUnlocked = (unlocked) => {
        if (unlocked) {
          formWrapper.classList.add("hidden");
          downloadAction.classList.remove("hidden");
        } else {
          formWrapper.classList.remove("hidden");
          downloadAction.classList.add("hidden");
        }
      };

      const currentUrl = new URL(window.location.href);
      const unlockedFromRedirect = currentUrl.searchParams.get(successParam) === key;
      const unlockedFromStorage = localStorage.getItem(key) === "unlocked";

      if (unlockedFromRedirect) {
        localStorage.setItem(key, "unlocked");
        currentUrl.searchParams.delete(successParam);
        window.history.replaceState({}, "", currentUrl.toString());
      }

      setUnlocked(unlockedFromRedirect || unlockedFromStorage);

      if (formEl instanceof HTMLFormElement && nextInput instanceof HTMLInputElement) {
        const setNextUrl = () => {
          const redirectUrl = new URL(window.location.href);
          redirectUrl.searchParams.set(successParam, key);
          nextInput.value = redirectUrl.toString();
        };

        setNextUrl();
        formEl.addEventListener("submit", setNextUrl);
      }

      root.setAttribute("data-gate-ready", "true");
    });
  })();
</script>
