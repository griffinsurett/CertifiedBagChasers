---
// src/components/BackgroundMedia.astro
import { getImage } from "astro:assets";
import { resolveImageMetadata } from "@/utils/images";

export interface Props {
  backgroundMedia: {
    image?: {
      src: any;
      imageClass?: string; // Use 'bg-fixed' for parallax effect
      // Convenience prop for automatic optimization
      aboveTheFold?: boolean; // Auto-sets priority, quality, eager loading
      // Manual overrides (if needed)
      quality?: number;
      widths?: {
        mobile: number;
        tablet: number;
        desktop: number;
      };
    };
    video?: {
      src: string;
      autoPlay?: boolean;
      muted?: boolean;
      loop?: boolean;
      playsInline?: boolean;
      controls?: boolean;
      preload?: string;
      videoClass?: string;
    };
    overlayClass?: string;
  };
}

const { backgroundMedia } = Astro.props;

// Automatic optimization based on position
const aboveTheFold = backgroundMedia?.image?.aboveTheFold ?? false;

// Quality settings based on position
// Above-the-fold: Lower quality (50-60%) - LCP optimization critical
// Below-the-fold: Higher quality (65-75%) - User is scrolling to see it
const qualitySettings = aboveTheFold
  ? { mobile: 46, tablet: 50, desktop: 55 }
  : { mobile: 58, tablet: 62, desktop: 66 };

const widthSettings = backgroundMedia?.image?.widths ?? (
  aboveTheFold
    ? { mobile: 640, tablet: 1024, desktop: 1600 }
    : { mobile: 480, tablet: 768, desktop: 1280 }
);

// Allow manual quality override
const customQuality = backgroundMedia?.image?.quality;

// Generate responsive images
let responsiveImages = null;

if (backgroundMedia?.image?.src) {
  const rawSrc = backgroundMedia.image.src;
  const imageMetadata = resolveImageMetadata(rawSrc);

  if (imageMetadata) {
    try {
      const [mobile, tablet, desktop] = await Promise.all([
        getImage({
          src: imageMetadata,
          format: "webp",
          quality: customQuality ?? qualitySettings.mobile,
          width: widthSettings.mobile,
        }),
        getImage({
          src: imageMetadata,
          format: "webp",
          quality: customQuality ?? qualitySettings.tablet,
          width: widthSettings.tablet,
        }),
        getImage({
          src: imageMetadata,
          format: "webp",
          quality: customQuality ?? qualitySettings.desktop,
          width: widthSettings.desktop,
        }),
      ]);
      
      responsiveImages = { mobile, tablet, desktop };
    } catch (error) {
      console.error('Failed to optimize background image:', error);
    }
  } else {
    const fallbackSrc =
      typeof rawSrc === "string"
        ? rawSrc
        : typeof rawSrc?.src === "string"
          ? rawSrc.src
          : "";

    responsiveImages = {
      mobile: { src: fallbackSrc },
      tablet: { src: fallbackSrc },
      desktop: { src: fallbackSrc },
    };
  }
}

const backgroundClassName = `bg-media-${Math.random().toString(36).slice(2, 10)}`;
const backgroundStyle = responsiveImages
  ? `--bg-media-mobile: url('${responsiveImages.mobile.src}'); --bg-media-tablet: url('${responsiveImages.tablet.src}'); --bg-media-desktop: url('${responsiveImages.desktop.src}');`
  : undefined;
---

{backgroundMedia?.video?.src ? (
  <video
    class={`absolute inset-0 z-0 w-full h-full object-cover ${backgroundMedia.video.videoClass || ""}`}
    autoplay={backgroundMedia.video.autoPlay !== false}
    muted={backgroundMedia.video.muted !== false}
    loop={backgroundMedia.video.loop !== false}
    playsinline={backgroundMedia.video.playsInline !== false}
    controls={backgroundMedia.video.controls || false}
    preload={backgroundMedia.video.preload || "metadata"}
    poster={responsiveImages?.mobile?.src || ""}
    aria-hidden="true"
  >
    <source src={backgroundMedia.video.src} type="video/mp4" />
    Your browser does not support the video tag.
  </video>
) : responsiveImages ? (
  <div
    class={`absolute inset-0 z-0 bg-cover bg-center bg-media-responsive ${backgroundClassName} ${backgroundMedia?.image?.imageClass || ""}`}
    style={backgroundStyle}
    aria-hidden="true"
  />
) : null}

{backgroundMedia?.overlayClass && (
  <div class={`absolute inset-0 z-0 ${backgroundMedia.overlayClass}`} aria-hidden="true"></div>
)}

{responsiveImages && (
  <style is:global>
    .bg-media-responsive {
      background-image: var(--bg-media-mobile);
    }
    @media (min-width: 641px) {
      .bg-media-responsive {
        background-image: var(--bg-media-tablet);
      }
    }
    @media (min-width: 1025px) {
      .bg-media-responsive {
        background-image: var(--bg-media-desktop);
      }
    }
  </style>
)}
