---
// src/layouts/HeadTags.astro
/**
 * Head Tags Component
 * 
 * Placeholder for additional head-level tags and scripts.
 * Can include:
 * - Analytics scripts (Google Analytics, Plausible, etc.)
 * - Font preloads
 * - External script tags
 * - Additional meta tags
 * 
 * Separated into its own component for easier maintenance
 * and conditional loading of third-party scripts.
 */
import IntHeadScripts from "@/integrations/IntHeadScripts.astro";
---
<IntHeadScripts />
<!-- Fonts: non-blocking Google Fonts load -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="preload"
  as="style"
  href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Oswald:wght@700;800;900&display=swap"
/>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Oswald:wght@700;800;900&display=swap"
  media="print"
  onload="this.media='all'"
/>
<noscript>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Oswald:wght@700;800;900&display=swap"
  />
</noscript>
