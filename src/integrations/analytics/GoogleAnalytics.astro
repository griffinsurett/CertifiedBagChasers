---
// src/integrations/analytics/GoogleAnalytics.astro
/**
 * Google Analytics 4 (gtag.js) with Consent Mode v2
 *
 * GDPR/CCPA Compliance:
 * - Sets denied defaults before analytics loads
 * - GA script blocked until user grants "performance" consent
 * - Consent updates are synced when preferences change
 */

const GA_MEASUREMENT_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

{GA_MEASUREMENT_ID && (
  <>
    {/*
      Consent Mode v2 is owned by Zest (`consentModeGoogle: true` in
      astro.config.mjs). Zest pushes the denied default before any tracker can
      run, then pushes updates on every consent change. All that is still
      needed here is the dataLayer/gtag shim GA itself expects.
    */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag(){window.dataLayer.push(arguments);};
    </script>

    <script
      type="text/plain"
      data-consent-category="analytics"
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
    />

    <script
      type="text/plain"
      data-consent-category="analytics"
      is:inline
      set:html={`
        window.gtag('js', new Date());
        window.gtag('config', '${GA_MEASUREMENT_ID}');
      `}
    />
  </>
)}
